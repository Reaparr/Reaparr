<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Keep initial IDE restores consistent with the pruned .NET lock files. -->
        <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Require forwarding an in-scope CancellationToken to cancellable async APIs. -->
        <AnalysisLevel>latest</AnalysisLevel>
        <WarningsAsErrors>$(WarningsAsErrors);CA2016</WarningsAsErrors>
        <ReaparrRuntimeMode Condition="'$(ReaparrRuntimeMode)' == ''">docker</ReaparrRuntimeMode>
        <ReaparrRuntimeIdentifier Condition="'$(ReaparrRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''"
            >$(RuntimeIdentifier)</ReaparrRuntimeIdentifier>
        <ReaparrRuntimeIdentifier Condition="'$(ReaparrRuntimeIdentifier)' == ''">unknown</ReaparrRuntimeIdentifier>
        <CSharpier_Bypass>true</CSharpier_Bypass>
    </PropertyGroup>
    <Target Name="PostClean" AfterTargets="Clean">
        <!-- Remove /bin -->
        <RemoveDir Directories="$(BaseOutputPath)" />
        <!-- Remove /obj -->
        <RemoveDir Directories="$(BaseIntermediateOutputPath)" />
    </Target>
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ReaparrRuntimeMode</_Parameter1>
            <_Parameter2>$(ReaparrRuntimeMode)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ReaparrRuntimeIdentifier</_Parameter1>
            <_Parameter2>$(ReaparrRuntimeIdentifier)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
