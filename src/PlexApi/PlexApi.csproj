<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Reaparr.PlexApi</RootNamespace>
        <AssemblyName>Reaparr.PlexApi</AssemblyName>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.1.0" />
        <PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FastEndpoints" Version="8.1.0" />
        <PackageReference Include="HttpClientToCurl" Version="2.1.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Application.Contracts\Application.Contracts.csproj" />
        <ProjectReference Include="..\Data.Contracts\Data.Contracts.csproj" />
        <ProjectReference Include="..\PlexApi.Contracts\PlexApi.Contracts.csproj" />
        <Compile Remove="Common\OpenPlexApiFactory.cs" />
        <ProjectReference Include="..\Settings.Contracts\Settings.Contracts.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.ComponentModel.DataAnnotations" />
        <Using Include="System.ComponentModel.DataAnnotations.Schema" />
        <Using Include="FastEndpoints" />
        <Using Include="Reaparr.FluentResults" />
        <Using Include="Reaparr.FluentResultExtensions" />
        <Using Include="FluentValidation" />
        <Using Include="Microsoft.AspNetCore.Http" />
        <Using Include="Reaparr.Application.Contracts" />
        <Using Include="Reaparr.Domain" />
        <Using Include="Reaparr.Logging" />
        <Using Include="Reaparr.Data.Contracts" />
        <Using Include="Reaparr.PlexApi.Contracts" />
        <Using Include="Reaparr.Settings.Contracts" />
        <Using Include="Serilog" />
    </ItemGroup>
</Project>
