<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <RootNamespace>Reaparr.AppHost</RootNamespace>
        <AssemblyName>Reaparr.AppHost</AssemblyName>
        <UserSecretsId>0732cfe0-5874-40d5-99f7-8794dfabd959</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
        <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
        <IsPackable>false</IsPackable>
        <DockerComposeProjectPath>..\..\docker\docker-compose.dcproj</DockerComposeProjectPath>
        <DockerfileFile>..\..\docker\Dockerfile</DockerfileFile>
        <DockerfileContext>.</DockerfileContext>
        <SpaRoot>ClientApp\</SpaRoot>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="FluentResultExtension.UnitTests" />
        <InternalsVisibleTo Include="Reaparr.AppHost.UnitTests" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FastEndpoints.Security" Version="8.3.0" />
        <PackageReference Include="FastEndpoints.OpenApi" Version="8.3.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.13" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="Quartz.Extensions.Hosting" Version="3.19.1" />
        <PackageReference Include="Velopack" Version="0.0.1298" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.AspNetCore.App.SignalR" Version="1.2.2" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Desktop\Window\Templates\DesktopStartupFailureDialog.html" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Application\Application.csproj" />
        <ProjectReference Include="..\Data\Data.csproj" />
        <ProjectReference Include="..\External\External.csproj" />
        <ProjectReference Include="..\FileSystem\FileSystem.csproj" />
        <ProjectReference Include="..\Identity\Identity.csproj" />
        <ProjectReference Include="..\PlexApi\PlexApi.csproj" />
        <ProjectReference Include="..\PublicAPI\PublicAPI.csproj" />
        <ProjectReference Include="..\Settings\Settings.csproj" />
        <ProjectReference Include="..\SignalR\SignalR.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Autofac" />
        <Using Include="System.ComponentModel.DataAnnotations" />
        <Using Include="System.ComponentModel.DataAnnotations.Schema" />
        <Using Include="FastEndpoints" />
        <Using Include="Reaparr.FluentResults" />
        <Using Include="Reaparr.FluentResultExtensions" />
        <Using Include="FluentValidation" />
        <Using Include="Microsoft.AspNetCore.Http" />
        <Using Include="Microsoft.AspNetCore.Builder" />
        <Using Include="Microsoft.AspNetCore.Hosting" />
        <Using Include="Microsoft.AspNetCore.Routing" />
        <Using Include="Microsoft.Extensions.Configuration" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.Logging" />
        <Using Include="Microsoft.EntityFrameworkCore" />
        <Using Include="Reaparr.Application" />
        <Using Include="Reaparr.Data" />
        <Using Include="Reaparr.Domain" />
        <Using Include="Reaparr.Environment" />
        <Using Include="Reaparr.External" />
        <Using Include="Reaparr.FileSystem" />
        <Using Include="Reaparr.Identity" />
        <Using Include="Reaparr.Logging" />
        <Using Include="Reaparr.PlexApi" />
        <Using Include="Reaparr.PublicAPI" />
        <Using Include="Reaparr.Settings" />
        <Using Include="Reaparr.SignalR" />
        <Using Include="Serilog" />
        <Using Include="System.Net.Http.Json" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="AppHost.csproj.DotSettings" />
        <None Remove="ClientApp\**" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="ClientApp\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="ClientApp\**" />
    </ItemGroup>
    <ItemGroup>
        <Content Remove="ClientApp\**" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="wwwroot\" />
    </ItemGroup>
</Project>
