# EditorConfig is awesome: https://EditorConfig.org
[*]
charset = utf-8
trim_trailing_whitespace = false
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 120

[*.cs]

# Microsoft .NET properties
csharp_new_line_before_members_in_object_initializers = false
# Require modifiers to follow the project's configured order.
csharp_preferred_modifier_order = public, private, protected, internal, new, static, abstract, virtual, sealed, readonly, override, extern, unsafe, volatile, async, required:warning
# Prefer var for local declarations outside built-in and immediately apparent type cases.
csharp_style_var_elsewhere = true:warning
# Prefer var when declaring locals with built-in types such as int or string.
csharp_style_var_for_built_in_types = true:warning
# Prefer var when the initializer makes the local variable's type apparent.
csharp_style_var_when_type_is_apparent = true:warning

# Keep optional single-statement if bodies brace-free.
resharper_csharp_braces_for_ifelse = not_required
# Rider formatting and syntax properties
resharper_csharp_blank_lines_after_block_statements = 1
resharper_csharp_blank_lines_after_control_transfer_statements = 1
resharper_csharp_blank_lines_before_block_statements = 0
resharper_csharp_blank_lines_before_control_transfer_statements = 0
resharper_csharp_empty_block_style = together_same_line
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1
csharp_space_after_cast = false
resharper_csharp_prefer_explicit_discard_declaration = true

# Rider inspection severities
resharper_enforce_if_statement_braces_highlighting = suggestion
# Allow ordinary .NET culture-sensitive sorting without requiring comparer arguments at every call site.
resharper_invocation_is_culture_sensitive_highlighting = none
resharper_default_string_comparer_usage_highlighting = none
resharper_stylecop_sa1101_highlighting = none
resharper_stylecop_sa1642_highlighting = none
resharper_suggest_var_or_type_built_in_types_highlighting = suggestion
resharper_suggest_var_or_type_elsewhere_highlighting = suggestion
resharper_suggest_var_or_type_simple_types_highlighting = suggestion
# Preserve explicit anonymous-object property names so source member changes do not rename the projected properties.
resharper_redundant_anonymous_type_property_name_highlighting = none
# Keep explicit constructors instead of converting them to primary constructors.
resharper_convert_to_primary_constructor_highlighting = none

# Keep traditional extension methods instead of C# 14 extension blocks.
resharper_convert_to_extension_block_highlighting = none
resharper_move_to_extension_block_highlighting = none

# Do not suggest converting existing code to collection expressions.
resharper_use_collection_expression_highlighting = none
dotnet_style_prefer_collection_expression = never

# Prefer Any()/!Any() for existence checks, not Count() comparisons.
resharper_use_method_any_0_highlighting = warning
resharper_use_method_any_1_highlighting = warning
resharper_use_method_any_2_highlighting = warning
resharper_use_method_any_3_highlighting = warning
resharper_use_method_any_4_highlighting = warning

# CA1827 blocks Count/LongCount for existence checks; warn to use Any() and avoid enumerating all matches.
dotnet_diagnostic.CA1827.severity = warning

# CA1860 prefers Count/Length/IsEmpty over Any(); disable because project policy uses Any() for existence checks.
dotnet_diagnostic.CA1860.severity = none
# Roslynator's default-enabled analyzers are active as feedback; explicit per-rule severities below define the intended build gate.
dotnet_analyzer_diagnostic.category-roslynator.severity = default
# MA0004 requires ConfigureAwait choices; disable blanket enforcement because the right context behavior varies by UI/request call chain.
dotnet_diagnostic.MA0004.severity = none
# MA0006 prefers String.Equals over ==/!=; disable because the repository deliberately uses ==/is for canonical string equality.
dotnet_diagnostic.MA0006.severity = none
# MA0169 prefers Equals over equality operators; disabled because == and != are the preferred comparison syntax.
dotnet_diagnostic.MA0169.severity = none
# MA0051 flags long methods; disable because method length alone is not evidence that extracting cohesive work improves clarity.
dotnet_diagnostic.MA0051.severity = none
# MA0158 requires System.Threading.Lock for lock-only fields; error blocks the old monitor type when behavior is preserved.
dotnet_diagnostic.MA0158.severity = error

# IDE0007 enforces var for locals; warning keeps declarations concise and consistent.
dotnet_diagnostic.IDE0007.severity = warning
# IDE0036 enforces modifier order; warning prevents inconsistent declaration syntax.
dotnet_diagnostic.IDE0036.severity = warning
# IDE0040 enforces accessibility modifiers outside interfaces; warning clarifies API visibility without redundant modifiers.
dotnet_diagnostic.IDE0040.severity = warning
# IDE0049 prefers C# aliases over framework names; disabled because alias spelling is outside the verified compiler gate.
dotnet_diagnostic.IDE0049.severity = none

# Blocking style/readability rules.
# MA0071 flags unnecessary else after an exiting branch; warning reduces nesting without altering control flow.
dotnet_diagnostic.MA0071.severity = warning
# MA0037 flags empty statements; warning catches stray semicolons that can hide an accidental empty body.
dotnet_diagnostic.MA0037.severity = warning
# MA0090 flags empty else/finally blocks; warn because unexplained empty branches obscure missing behavior or cleanup.
dotnet_diagnostic.MA0090.severity = warning
# MA0073 removes redundant true/false comparisons; warn because simpler conditions improve readability without changing behavior.
dotnet_diagnostic.MA0073.severity = warning
# MA0100 detects tasks that outlive a disposable they use; warn to prevent use-after-dispose races and resource leaks.
dotnet_diagnostic.MA0100.severity = warning
# MA0129 flags disposing a Task instead of its produced async resource; warn because the intended resource may remain undisposed.
dotnet_diagnostic.MA0129.severity = warning
# RCS1151 flags unnecessary casts; warn to remove noise and avoid obscuring the accessed member's actual type.
dotnet_diagnostic.RCS1151.severity = warning
# RCS1238 flags nested ternaries; none because nested conditional expressions are an accepted readability choice here.
dotnet_diagnostic.RCS1238.severity = none
# RCS1015 replaces symbol-name strings with nameof; warn to keep references synchronized with renames.
dotnet_diagnostic.RCS1015.severity = warning
# RCS1172 prefers is over as for null checks; warn because the type test is clearer and avoids a cast local.
dotnet_diagnostic.RCS1172.severity = warning
# RCS1113 simplifies null-plus-empty checks to IsNullOrEmpty; warn to express the exact intent once.
dotnet_diagnostic.RCS1113.severity = warning
# RCS1032 flags redundant parentheses; warn to remove syntax noise while retaining required grouping.
dotnet_diagnostic.RCS1032.severity = warning
# RCS1163 flags unused parameters; warn because unused inputs confuse APIs and hide stale call contracts.
dotnet_diagnostic.RCS1163.severity = warning
# RCS1199 flags redundant null checks; warn to simplify conditions whose nullability is already established.
dotnet_diagnostic.RCS1199.severity = warning

# Approved blocking correctness targets.
# CA1828 flags CountAsync/LongCountAsync for existence checks; warning favors AnyAsync to avoid unnecessary counting.
dotnet_diagnostic.CA1828.severity = warning
# CA2012 flags unsafe ValueTask use; warn to prevent consuming a single-use asynchronous result more than once.
dotnet_diagnostic.CA2012.severity = warning
# MA0042 flags sync calls when an async alternative exists; warn to avoid blocking I/O threads in async-capable paths.
dotnet_diagnostic.MA0042.severity = warning
# MA0022 flags null Task returns; warn because callers expect an awaitable representing completion/value.
dotnet_diagnostic.MA0022.severity = warning
# MA0054 flags replacement exceptions that discard the caught cause; warn to preserve diagnostic and causal context.
dotnet_diagnostic.MA0054.severity = warning
# RCS1075 flags empty catch blocks; warn because swallowed failures conceal broken behavior and diagnostics.
dotnet_diagnostic.RCS1075.severity = warning
# MA0085 flags anonymous event unsubscription handlers; warn because they cannot reliably detach the subscribed delegate.
dotnet_diagnostic.MA0085.severity = warning
# MA0061 catches changed optional defaults across overrides; warn because static receiver type would otherwise change omitted-argument behavior.
dotnet_diagnostic.MA0061.severity = warning
# MA0010 requires AttributeUsage on custom attributes; warn to prevent unintended application targets.
dotnet_diagnostic.MA0010.severity = warning
# MA0047 requires a named namespace; warn to prevent global collisions and allow ordinary namespace-based discovery.
dotnet_diagnostic.MA0047.severity = warning
# MA0048 requires type/file names to match; none because cohesive files may group related types and filename-only consistency is not a project requirement.
dotnet_diagnostic.MA0048.severity = none
# MA0074 requires an explicit string-comparison culture; disable it because the correct ordinal/culture semantics are contract-specific.
dotnet_diagnostic.MA0074.severity = none
# MA0016 prefers interfaces over List/Dictionary; suggestion only because concrete types may be required by mutation/DTO contracts, not worth changing signatures blindly.
dotnet_diagnostic.MA0016.severity = suggestion
# MA0002 requires explicit string comparers; disabled because project policy follows platform defaults unless string identity has a defined comparison contract.
dotnet_diagnostic.MA0002.severity = none
# MA0011 requires IFormatProvider on culture-sensitive Parse/TryParse/ToString calls; disabled because provider arguments are unnecessary for this project's intended parsing usage.
dotnet_diagnostic.MA0011.severity = none
# MA0026 treats TODO comments as diagnostics; disabled because TODOs are planning notes, not build failures.
dotnet_diagnostic.MA0026.severity = none
dotnet_diagnostic.CA1508.severity = suggestion
# CA2000 flags undisposed IDisposable instances; suggestion because ownership sometimes transfers across layers and needs review.
dotnet_diagnostic.CA2000.severity = suggestion
# MA0134 flags discarded awaitables in synchronous contexts; suggestion because intentional fire-and-forget needs contextual review.
dotnet_diagnostic.MA0134.severity = suggestion
# MA0140 flags identical conditional branches; suggestion because branch intent can be clearer than mechanical consolidation.
dotnet_diagnostic.MA0140.severity = suggestion
# MA0024 prefers explicit string comparers; suggestion because domain-specific sorting/equality may intentionally use defaults.
dotnet_diagnostic.MA0024.severity = suggestion
# MA0084 flags locals hiding other symbols; suggestion because some shadowing is harmless but may hinder comprehension.
dotnet_diagnostic.MA0084.severity = suggestion
# MA0108 removes explicit CallerArgumentExpression arguments; suggestion because explicit values may intentionally communicate intent.
dotnet_diagnostic.MA0108.severity = suggestion

dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:none
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:none
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:none
# Prefer C# keywords such as int and string over framework type names in declarations.
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
# Prefer C# keywords such as int and string over framework type names when accessing static members.
dotnet_style_predefined_type_for_member_access = true:warning
# Require explicit accessibility on non-interface members while omitting unnecessary accessibility on interface members.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Private constants rule
dotnet_naming_rule.private_constants_rule.severity = warning
dotnet_naming_rule.private_constants_rule.symbols = private_constants_symbols
dotnet_naming_rule.private_constants_rule.style = all_upper_case_style

dotnet_naming_symbols.private_constants_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_constants_symbols.applicable_kinds = field
dotnet_naming_symbols.private_constants_symbols.required_modifiers = const

dotnet_naming_style.all_upper_case_style.capitalization = all_upper
dotnet_naming_style.all_upper_case_style.word_separator = _


# Naming rule for private static readonly fields
dotnet_naming_rule.private_static_readonly_fields_should_be_camel_with_underscore.severity = warning
dotnet_naming_rule.private_static_readonly_fields_should_be_camel_with_underscore.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_should_be_camel_with_underscore.style = camel_with_underscore

dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.camel_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_with_underscore.required_prefix = _
dotnet_naming_style.camel_with_underscore.required_suffix =



# TUnit0048 requires instance test methods, so CA1822 is limited to private/internal helpers instead of framework-invoked public tests.
# CA1822 flags members that can be static; exclude public test methods because TUnit discovers/invokes them as instance methods.
[tests/UnitTests/**/*Tests.cs]
dotnet_code_quality.CA1822.api_surface = private, internal

[tests/IntegrationTests/**/*Tests.cs]
dotnet_code_quality.CA1822.api_surface = private, internal

# Disable ReSharper's using-resource-initialization suggestion here: explicit disposal scopes are intentional across async test flows.
# TODO comments remain useful reminders, but must not turn unfinished notes into errors.
resharper_todo_comment_highlighting = suggestion
resharper_using_statement_resource_initialization_highlighting = none
