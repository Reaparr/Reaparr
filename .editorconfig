# EditorConfig is awesome: https://EditorConfig.org
[*]
charset = utf-8
trim_trailing_whitespace = false
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 120

[*.cs]

# Microsoft .NET properties
csharp_new_line_before_members_in_object_initializers = false
# Require modifiers to follow the project's configured order.
csharp_preferred_modifier_order = public, private, protected, internal, new, static, abstract, virtual, sealed, readonly, override, extern, unsafe, volatile, async, required:warning
# Prefer var for local declarations outside built-in and immediately apparent type cases.
csharp_style_var_elsewhere = true:warning
# Prefer var when declaring locals with built-in types such as int or string.
csharp_style_var_for_built_in_types = true:warning
# Prefer var when the initializer makes the local variable's type apparent.
csharp_style_var_when_type_is_apparent = true:warning

# Keep optional single-statement if bodies brace-free.
resharper_csharp_braces_for_ifelse = not_required
# Rider formatting and syntax properties
resharper_csharp_blank_lines_after_block_statements = 1
resharper_csharp_blank_lines_after_control_transfer_statements = 1
resharper_csharp_blank_lines_before_block_statements = 0
resharper_csharp_blank_lines_before_control_transfer_statements = 0
resharper_csharp_empty_block_style = together_same_line
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1
csharp_space_after_cast = false
resharper_csharp_prefer_explicit_discard_declaration = true

# Rider inspection severities
resharper_enforce_if_statement_braces_highlighting = suggestion
resharper_invocation_is_culture_sensitive_highlighting = none
resharper_stylecop_sa1101_highlighting = none
resharper_stylecop_sa1642_highlighting = none
resharper_suggest_var_or_type_built_in_types_highlighting = suggestion
resharper_suggest_var_or_type_elsewhere_highlighting = suggestion
resharper_suggest_var_or_type_simple_types_highlighting = suggestion

# Keep traditional extension methods instead of C# 14 extension blocks.
resharper_convert_to_extension_block_highlighting = none
resharper_move_to_extension_block_highlighting = none

# Do not suggest converting existing code to collection expressions.
resharper_use_collection_expression_highlighting = none
dotnet_style_prefer_collection_expression = never

# Prefer Any()/!Any() for existence checks, not Count() comparisons.
resharper_use_method_any_0_highlighting = warning
resharper_use_method_any_1_highlighting = warning
resharper_use_method_any_2_highlighting = warning
resharper_use_method_any_3_highlighting = warning
resharper_use_method_any_4_highlighting = warning

# CA1827: Do not use Count()/LongCount() when Any() can be used
dotnet_diagnostic.CA1827.severity = warning

# Do not suggest replacing Any() with a Count/Length/IsEmpty property.
dotnet_diagnostic.CA1860.severity = none
# Added analyzers are opt-in; SDK and framework analyzer defaults remain unchanged.
dotnet_analyzer_diagnostic.category-roslynator.severity = none

# Blocking SDK style diagnostics.
# IDE0007 reports explicit local types where the configured style prefers var.
dotnet_diagnostic.IDE0007.severity = warning
# IDE0036 reports modifiers that do not follow the configured modifier order.
dotnet_diagnostic.IDE0036.severity = warning
# IDE0040 enforces the configured accessibility style, requiring modifiers outside interfaces and omitting unnecessary interface modifiers.
dotnet_diagnostic.IDE0040.severity = warning
# IDE0049 recommends C# keywords such as int instead of Int32, but is disabled because it is not part of the verified compiler gate.
dotnet_diagnostic.IDE0049.severity = none

# Blocking style/readability rules.
# MA0071 reports an unnecessary else after a branch that unconditionally exits.
dotnet_diagnostic.MA0071.severity = warning
# MA0100 reports a returned task that can outlive a disposable resource used by its operation.
dotnet_diagnostic.MA0100.severity = warning
# MA0129 reports using a task as a disposable instead of awaiting the disposable resource it produces.
dotnet_diagnostic.MA0129.severity = warning
# RCS1151 reports casts that are unnecessary for the accessed member or operation.
dotnet_diagnostic.RCS1151.severity = warning
# RCS1238 reports nested ternary operators, but is disabled because those expressions are an accepted readability choice.
dotnet_diagnostic.RCS1238.severity = none

# Approved blocking correctness targets.
# CA1828 reports CountAsync or LongCountAsync calls used only to test whether any results exist.
dotnet_diagnostic.CA1828.severity = warning
# CA2012 reports unsafe ValueTask consumption, such as awaiting the same instance more than once.
dotnet_diagnostic.CA2012.severity = warning
# MA0042 reports synchronous operations in async-capable code when an asynchronous alternative is available.
dotnet_diagnostic.MA0042.severity = warning

# Approved advisory targets.
# CA1508 reports conditions that dataflow analysis determines are always true or false.
dotnet_diagnostic.CA1508.severity = suggestion
# CA2000 reports disposable objects that leave their ownership scope without being disposed or transferred safely.
dotnet_diagnostic.CA2000.severity = suggestion
# MA0134 reports unobserved awaitable results in synchronous methods or non-async lambdas.
dotnet_diagnostic.MA0134.severity = suggestion
# MA0140 reports conditional branches that execute identical code.
dotnet_diagnostic.MA0140.severity = suggestion

dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:none
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:none
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:none
# Prefer C# keywords such as int and string over framework type names in declarations.
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
# Prefer C# keywords such as int and string over framework type names when accessing static members.
dotnet_style_predefined_type_for_member_access = true:warning
# Require explicit accessibility on non-interface members while omitting unnecessary accessibility on interface members.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Private constants rule
dotnet_naming_rule.private_constants_rule.severity = warning
dotnet_naming_rule.private_constants_rule.symbols = private_constants_symbols
dotnet_naming_rule.private_constants_rule.style = all_upper_case_style

dotnet_naming_symbols.private_constants_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_constants_symbols.applicable_kinds = field
dotnet_naming_symbols.private_constants_symbols.required_modifiers = const

dotnet_naming_style.all_upper_case_style.capitalization = all_upper
dotnet_naming_style.all_upper_case_style.word_separator = _


# Naming rule for private static readonly fields
dotnet_naming_rule.private_static_readonly_fields_should_be_camel_with_underscore.severity = warning
dotnet_naming_rule.private_static_readonly_fields_should_be_camel_with_underscore.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_should_be_camel_with_underscore.style = camel_with_underscore

dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.camel_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_with_underscore.required_prefix = _
dotnet_naming_style.camel_with_underscore.required_suffix =



# TUnit test methods must be instance methods (TUnit0048).
# Keep CA1822 active for private/internal helpers, not framework-invoked public tests.
[tests/UnitTests/**/*Tests.cs]
dotnet_code_quality.CA1822.api_surface = private, internal

[tests/IntegrationTests/**/*Tests.cs]
dotnet_code_quality.CA1822.api_surface = private, internal
