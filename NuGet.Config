<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="QuartzPreview" value="https://f.feedz.io/quartznet/quartznet/nuget/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="QuartzPreview">
            <package pattern="Quartz" />
            <package pattern="Quartz.EntityFrameworkCore" />
        </packageSource>
    </packageSourceMapping>
</configuration>
