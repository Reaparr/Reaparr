<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Reaparr.Build</RootNamespace>
        <AssemblyName>Reaparr.Build</AssemblyName>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Reaparr.AppHost.UnitTests" />
        <InternalsVisibleTo Include="Reaparr.Build.UnitTests" />
        <PackageReference Include="Autofac" Version="9.3.4" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageReference Include="CliWrap" Version="3.10.5" />
        <PackageReference Include="FastEndpoints" Version="9.0.0" />
        <PackageReference Include="FluentValidation" Version="12.2.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
        <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
        <PackageReference Include="System.IO.Abstractions" Version="23.0.1" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Serilog" />
        <Using Include="Reaparr.FluentResults" />
        <Using Include="Reaparr.FluentResultExtensions" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Domain\Domain.csproj" />
        <ProjectReference Include="..\..\src\Environment\Environment.csproj" />
    </ItemGroup>
</Project>
