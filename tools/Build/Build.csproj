<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Reaparr.Build</RootNamespace>
        <AssemblyName>Reaparr.Build</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Reaparr.AppHost.UnitTests" />
        <InternalsVisibleTo Include="Reaparr.Build.UnitTests" />
        <PackageReference Include="Autofac" Version="9.1.0" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="CliWrap" Version="3.10.1" />
        <PackageReference Include="FastEndpoints" Version="8.1.0" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
        <PackageReference Include="System.IO.Abstractions" Version="22.1.1" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Serilog" />
        <Using Include="Reaparr.FluentResults" />
        <Using Include="Reaparr.FluentResultExtensions" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Domain\Domain.csproj" />
    </ItemGroup>
</Project>
